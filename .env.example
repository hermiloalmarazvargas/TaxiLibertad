# Copia este archivo como .env (no se sube a git).
# Valores locales: los muestra `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
# PUBLISHABLE_KEY: es pública, la usan las apps y el panel.
SUPABASE_PUBLISHABLE_KEY=
# SECRET_KEY: acceso total, ignora RLS. Solo para scripts del administrador.
SUPABASE_SECRET_KEY=
