# Copia este archivo como .env.local (no se sube a git).
# Valores locales: los muestra `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Solo la llave PUBLICABLE. Nunca pongas aquí la llave secreta:
# todo lo que empieza con VITE_ termina dentro del JavaScript del navegador.
VITE_SUPABASE_PUBLISHABLE_KEY=
